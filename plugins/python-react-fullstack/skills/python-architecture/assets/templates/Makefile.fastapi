# {{project_name}} - developer commands. Run `make` or `make help` to list targets.
.DEFAULT_GOAL := help
SHELL := /bin/bash
.SHELLFLAGS := -eu -o pipefail -c

UV  ?= uv
RUN := $(UV) run
SRC := src tests

##@ Setup
.PHONY: install
install: ## Create venv, install all deps from the lockfile, install git hooks
	$(UV) sync --all-groups
	@if git rev-parse --git-dir >/dev/null 2>&1; then $(RUN) pre-commit install; \
	else echo "Not a git repo yet - run 'git init && make install' to enable hooks"; fi

.PHONY: lock
lock: ## Re-resolve dependencies and update uv.lock
	$(UV) lock

.PHONY: upgrade
upgrade: ## Upgrade all dependencies within their constraints
	$(UV) lock --upgrade
	$(UV) sync --all-groups

##@ Run
HOST ?= 0.0.0.0
PORT ?= 8000
APP  := {{package_name}}.main:app
IMAGE ?= {{project_name}}

.PHONY: dev
dev: ## Run the API with auto-reload
	$(RUN) uvicorn $(APP) --reload --host $(HOST) --port $(PORT)

.PHONY: run
run: ## Run the API as in production (no reload)
	$(RUN) uvicorn $(APP) --host $(HOST) --port $(PORT)

.PHONY: docker-build
docker-build: ## Build the container image
	docker build -t $(IMAGE):latest .

.PHONY: docker-run
docker-run: ## Run the container image locally
	docker run --rm -p $(PORT):8000 --env-file .env $(IMAGE):latest

# Uncomment once Alembic is added (`uv add alembic sqlalchemy`, `uv run alembic init migrations`)
# .PHONY: migrate migration
# migrate: ## Apply database migrations
# 	$(RUN) alembic upgrade head
# migration: ## Create a migration: make migration m="add users table"
# 	$(RUN) alembic revision --autogenerate -m "$(m)"

##@ Quality
.PHONY: format
format: ## Auto-format and apply safe lint fixes
	$(RUN) ruff format $(SRC)
	$(RUN) ruff check --fix $(SRC)

.PHONY: format-check
format-check: ## Verify formatting without changing files
	$(RUN) ruff format --check $(SRC)

.PHONY: lint
lint: ## Run ruff linter
	$(RUN) ruff check $(SRC)

.PHONY: typecheck
typecheck: ## Run mypy
	$(RUN) mypy $(SRC)

.PHONY: test
test: ## Run tests
	$(RUN) pytest

.PHONY: cov
cov: ## Run tests with coverage report (fails under threshold)
	$(RUN) pytest --cov --cov-report=term-missing --cov-report=html

.PHONY: check
check: format-check lint typecheck test ## Everything CI runs - use before every commit/PR
	$(UV) lock --check

.PHONY: pre-commit
pre-commit: ## Run all pre-commit hooks against all files
	$(RUN) pre-commit run --all-files

##@ Housekeeping
.PHONY: clean
clean: ## Remove caches and build artifacts
	rm -rf .pytest_cache .mypy_cache .ruff_cache htmlcov .coverage dist build
	find . -type d -name __pycache__ -prune -exec rm -rf {} +

.PHONY: help
help: ## Show this help
	@awk 'BEGIN {FS = ":.*##"; printf "\nUsage: make \033[36m<target>\033[0m\n"} \
		/^[a-zA-Z0-9_-]+:.*?##/ { printf "  \033[36m%-15s\033[0m %s\n", $$1, $$2 } \
		/^##@/ { printf "\n\033[1m%s\033[0m\n", substr($$0, 5) }' $(MAKEFILE_LIST)
