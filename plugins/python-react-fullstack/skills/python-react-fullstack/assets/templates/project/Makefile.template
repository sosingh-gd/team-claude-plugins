.PHONY: dev api api-check test lint

dev: ## run db, backend and frontend
	docker compose up -d db
	(cd backend && uv run fastapi dev app/main.py --port 8000) & (cd frontend && npm run dev)

api: ## export OpenAPI from the backend + regenerate frontend types
	cd backend && uv run python -m app.scripts.export_openapi ../contract/openapi.json
	cd frontend && npm run api:gen

api-check: api ## CI: fail if the committed contract is stale
	git diff --exit-code contract/openapi.json frontend/src/lib/api/schema.d.ts || \
	  (echo "API contract out of date: run make api and commit" && exit 1)

test:
	cd backend && uv run pytest
	cd frontend && npm test -- --run

lint:
	cd backend && uv run ruff check . && uv run ruff format --check . && uv run mypy app
	cd frontend && npm run lint && npm run typecheck
