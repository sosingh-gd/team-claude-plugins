import uuid
from collections.abc import AsyncIterator

from app.core.schemas import ApiModel

from .events import RunCompletedEvent, RunStartedEvent, TextDeltaEvent
from .schemas import AgentRunRequest


class AgentService:
    """Adapter between your LLM SDK / agent framework and the AgentEvent contract.

    Map provider-native events to contract events here, so the frontend never changes
    when the provider does. Use session_factory() for short DB writes; don't hold a
    request-scoped session for the whole stream.
    """

    async def run(self, req: AgentRunRequest) -> AsyncIterator[ApiModel]:
        run_id = str(uuid.uuid4())
        yield RunStartedEvent(run_id=run_id)

        # TODO: replace this echo with the provider stream, e.g.
        #   async for chunk in llm.stream(messages=...):
        #       if chunk is text:      yield TextDeltaEvent(text=chunk.text)
        #       if chunk is tool call: yield ToolCallEvent(...); run tool; yield ToolResultEvent(...)
        for word in f"You said: {req.messages[-1].content}".split(" "):
            yield TextDeltaEvent(text=word + " ")

        message_id = str(uuid.uuid4())  # TODO: persist the final assistant message, return its id
        yield RunCompletedEvent(message_id=message_id)


def get_agent_service() -> AgentService:
    return AgentService()
