// features/{{entities}}/{{entities}}.api.ts — server calls, query keys and query hooks for this feature.
// One file to start with. Split into api/ (calls, keys, hooks) only once it grows past ~150 lines.
import { useInfiniteQuery, useMutation, useQuery, useQueryClient } from '@tanstack/react-query';
import { api, unwrap } from '@/lib/http';
import type { {{Entity}}, {{Entity}}Create, {{Entity}}ListParams, {{Entity}}Update } from './types';

const {{entities}}Api = {
  list: (query: {{Entity}}ListParams, signal?: AbortSignal) =>
    unwrap(api.GET('/api/v1/{{route}}', { params: { query }, signal })),

  get: (id: string, signal?: AbortSignal) =>
    unwrap(api.GET('/api/v1/{{route}}/{{{entity_snake}}_id}', { params: { path: { {{entity_snake}}_id: id } }, signal })),

  create: (body: {{Entity}}Create) => unwrap(api.POST('/api/v1/{{route}}', { body })),

  update: (id: string, body: {{Entity}}Update) =>
    unwrap(api.PATCH('/api/v1/{{route}}/{{{entity_snake}}_id}', { params: { path: { {{entity_snake}}_id: id } }, body })),

  remove: (id: string) =>
    unwrap(api.DELETE('/api/v1/{{route}}/{{{entity_snake}}_id}', { params: { path: { {{entity_snake}}_id: id } } })),
};

export const {{entity}}Keys = {
  all: ['{{entities}}'] as const,
  lists: () => [...{{entity}}Keys.all, 'list'] as const,
  list: (params: Omit<{{Entity}}ListParams, 'cursor'>) => [...{{entity}}Keys.lists(), params] as const,
  detail: (id: string) => [...{{entity}}Keys.all, 'detail', id] as const,
};

export function use{{Entity}}ListQuery(params: Omit<{{Entity}}ListParams, 'cursor'> = {}) {
  return useInfiniteQuery({
    queryKey: {{entity}}Keys.list(params),
    queryFn: ({ pageParam, signal }) => {{entities}}Api.list({ ...params, cursor: pageParam }, signal),
    initialPageParam: undefined as string | undefined,
    getNextPageParam: (last) => last.nextCursor ?? undefined,
  });
}

export function use{{Entity}}Query(id: string) {
  return useQuery({
    queryKey: {{entity}}Keys.detail(id),
    queryFn: ({ signal }) => {{entities}}Api.get(id, signal),
  });
}

export function useCreate{{Entity}}Mutation() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: {{entities}}Api.create,
    onSuccess: (created: {{Entity}}) => {
      qc.setQueryData({{entity}}Keys.detail(created.id), created);
      return qc.invalidateQueries({ queryKey: {{entity}}Keys.lists() });
    },
  });
}

export function useUpdate{{Entity}}Mutation(id: string) {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: (body: {{Entity}}Update) => {{entities}}Api.update(id, body),
    onSuccess: (updated: {{Entity}}) => {
      qc.setQueryData({{entity}}Keys.detail(id), updated);
      return qc.invalidateQueries({ queryKey: {{entity}}Keys.lists() });
    },
  });
}

export function useDelete{{Entity}}Mutation() {
  const qc = useQueryClient();
  return useMutation({
    mutationFn: {{entities}}Api.remove,
    onSuccess: (_data, id) => {
      qc.removeQueries({ queryKey: {{entity}}Keys.detail(id) });
      return qc.invalidateQueries({ queryKey: {{entity}}Keys.lists() });
    },
  });
}
